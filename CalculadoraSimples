<!DOCTYPE html>
<html>
  <meta charset = "utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Calculadora</title>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<head>
    <title>Calculadora</title>
 <style>
	body{ 
    background-image: url('https://previews.123rf.com/images/piter2121/piter21211804/piter2121180400111/99439646-abstract-mathematics-background-with-colorful-numbers-on-chalkboard-copy-space-for-your-design.jpg');
    }
</style>  

    <script>
        
        function soma() {
            let n1 = document.getElementById("num1").value;
            let n2 = document.getElementById("num2").value;
 
            let resultado = parseFloat(n1) + parseFloat(n2);
 
            let texto = "<p style='color:red'>Soma = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
 
        function subtrai() {
            let n1 = document.getElementById("num1").value;
            let n2 = document.getElementById("num2").value;
 
            let resultado = parseFloat(n1) - parseFloat(n2);
 
            let texto = "<p style='color:blue'>Subtracao = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
         function multiplicar() {
            let n1 = document.getElementById("num1").value;
            let n2 = document.getElementById("num2").value;
 
            let resultado = parseFloat(n1) * parseFloat(n2);
 
            let texto = "<p style='color:green'>Multiplicacao = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
        function dividir() {
            let n1 = document.getElementById("num1").value;
            let n2 = document.getElementById("num2").value;
 
            let resultado = parseFloat(n1) / parseFloat(n2);
 
            let texto = "<p style='color:purple'>Divisao = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
        function potencia() {
            let base = document.getElementById("num1").value;
            let expoente = document.getElementById("num2").value;
 
            let resultado = base ** expoente;
 
            let texto = "<p style='color:orange'>Potencia = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
        function porcentagem() {
            let n1 = document.getElementById("num1").value;
            let n2 = document.getElementById("num2").value;
 
            let resultado = parseFloat(n1) * parseFloat(n2) / 100;
 
            let texto = "<p style='color:brown'>Porcentagem = " + resultado + "</p>";
            document.getElementById("resultado").innerHTML = texto;
        }
    </script>
</head>
 
<body>
    <label for="num1" style="color:white">Numero 1</label><br>
    <input type="number" id="num1" value="0"> <br><br>
    <label for="num2"style="color: white">Numero 2</label><br>
    <input type="number" id="num2" value="0"> <br><br>
    
 
    <button type="button" class="btn btn-primary" onclick="soma()">+</button>
    <button type="button" class="btn btn-success"onclick="subtrai()">-</button>
    <button type="button" class="btn btn-danger"onclick="multiplicar()">x</button>
    <button type="button" class="btn btn-warning"onclick="dividir()">/</button>
    <button type="button" class="btn btn-info"onclick="potencia()">Potencia</button>
    <button type="button" class="btn btn-secondary btn-lg"onclick="porcentagem()">%</button>
    <br><br>
    <div id="resultado" style="color:white">O resultado é:</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
